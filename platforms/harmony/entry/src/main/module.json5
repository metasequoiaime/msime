{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "KeyboardExtensionAbility",
    // phone and 2in1 are the two form factors the shared contract distinguishes: the phone panel is a
    // soft keyboard, the 2in1 one is a candidate window driven by a physical keyboard.
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 华为账号登录（Account Kit）认的是 AppGallery Connect「常规 > 应用」里应用的 Client ID。它与 APP ID 不同时，要在 module 这一级加 "metadata": [{ "name": "client_id", "value": "<应用 Client ID>" }]，value 直接写 AGC 给的数字，不能用 $string 引用，也不能填项目 Client ID（华为文档「配置Client ID」，harmonyos-guides/account-client-id）；两者相同时不用配。服务端 auth.huawei.client_ids 要列同一个值，否则 ID Token 的受众对不上。scripts/test-harmony-manifest.py 核对它的位置和形状。
    // Reading the system clipboard is a system_basic permission on OpenHarmony, so an ordinary
    // third-party input method is refused it however it asks: the request is granted only to a build
    // signed with a provisioning profile that carries the ACL for it. Declared so such a build works,
    // and the keyboard checks at runtime rather than presenting an empty clipboard as an empty one.
    "requestPermissions": [
      { "name": "ohos.permission.ACCESS_BIOMETRIC" },
      // 「防止截屏」打开后给设置应用的窗口（`setWindowPrivacyMode`）和键盘的面板（`Panel.setPrivacyMode`）设隐私模式要用它。normal 级、system_grant，声明即授予，不弹授权框，见 keyboard/settings/ScreenCaptureProtection.ets。
      { "name": "ohos.permission.PRIVACY_WINDOW" },
      {
        // Account and cloud clipboard requests use the HTTPS account service only when the user
        // opens the account or cloud surface; ordinary offline typing never touches the network.
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_permission_reason",
        "usedScene": {
          "abilities": ["EntryAbility", "KeyboardExtensionAbility"],
          "when": "inuse"
        }
      },
      {
        // normal and system-granted: declaring it is all a keyboard needs to buzz a key.
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:vibrate_permission_reason",
        "usedScene": {
          "abilities": ["KeyboardExtensionAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:clipboard_permission_reason",
        "usedScene": {
          "abilities": ["KeyboardExtensionAbility"],
          "when": "inuse"
        }
      },
      {
        // The keyboard captures the microphone itself (HarmonyPcmCapture) for every recognizer: CoreSpeechKit in write-audio mode, Doubao, the HTTP providers and the on-device model. Raw audio is never handed to the Engine, written to disk or logged; it leaves the device only for the cloud service the user selected.
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_permission_reason",
        "usedScene": {
          "abilities": ["KeyboardExtensionAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        // The keyboard is an extension and has no window of its own beyond its panel. This is where
        // everything that is a setting rather than a keystroke lives, and on a 2in1 it is the only
        // place: a candidate window has no key faces to reach a surface from.
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entry_ability_desc",
        "label": "$string:entry_ability_label",
        // What the launcher draws. Without it the entry falls back to the application icon, which is
        // the same artwork today and so hid the omission; an ability that appears on the home screen
        // states its own.
        // 分层图标：桌面按自己的遮罩裁圆角，背景层是标志的绿边色 #A8DF8E，前景层是撑满画布的标志；单张透明底的 app_icon 在桌面上会透出壁纸。
        "icon": "$media:app_icon_layered",
        // 启动屏图标是网页开屏的第一帧：浅色圆盘上一个还没描笔画的标志方块（start_window_icon.png，585×621，顶上留 36px 透明），启动窗、原生盖板和开屏因此是同一个画面，见 .agents/notes/implemented/feature/2026-10-11-harmony-launch-one-picture.md 和 scripts/test-harmony-launch-continuity.py。
        "startWindowIcon": "$media:start_window_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          // Google 登录回跳页上的「回到水杉输入法」按钮（msime://auth/google）。浏览器打开它就把本应用拉回前台；want 不带页面参数，onNewWant 什么也不做。
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              {
                "scheme": "msime",
                "host": "auth"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "KeyboardExtensionAbility",
        "srcEntry": "./ets/inputmethodextability/KeyboardExtensionAbility.ets",
        "description": "$string:keyboard_ability_desc",
        "label": "$string:keyboard_ability_label",
        // The mark the system input-method list draws next to the name, and the one the switcher shows. The module schema requires it of whichever element is mainElement, and this is it; without it the keyboard sat in that list with a name and no logo.
        // 上架审核要求包内配置的图标没有透明像素：这里用分层图标的背景层和前景层压成的不透明 app_icon_opaque.png，透明底的 app_icon 只留给键盘里当图片用。
        "icon": "$media:app_icon_opaque",
        "type": "inputMethod",
        "exported": true,
        // 「输入法应用内数据共享」：与设置应用共用的共享沙箱（context.getGroupDir）。这个 ID 由 AppGallery Connect 签发，签名 Profile 的 data-group-ids 必须带着同一个值，否则 getGroupDir 拿不到目录，两边退回各自的 files/state。代码里的同一个值在 keyboard/SharedStateMirror.ets 的 DATA_GROUP_ID。
        "dataGroupIds": ["group.1516753898738609107"]
      }
    ]
  }
}
