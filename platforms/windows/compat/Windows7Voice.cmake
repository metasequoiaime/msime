# 由专用运行库构建通过 CMAKE_PROJECT_INCLUDE 注入，不修改上游源码或普通包。
if(NOT PROJECT_NAME STREQUAL "onnxruntime")
  return()
endif()
if(NOT MSVC OR NOT WIN32)
  message(FATAL_ERROR "Win7 语音运行库适配需要 Windows MSVC")
endif()
file(TO_CMAKE_PATH "${CMAKE_CURRENT_LIST_DIR}/Windows7VoiceRedirect.h" msime_voice_redirect)
foreach(msime_voice_source IN ITEMS
    core/platform/path_lib.cc
    core/platform/windows/env.cc
    core/platform/windows/env_time.cc
    core/platform/windows/device_discovery.cc)
  set(msime_voice_file "${CMAKE_CURRENT_SOURCE_DIR}/../onnxruntime/${msime_voice_source}")
  if(NOT EXISTS "${msime_voice_file}")
    message(FATAL_ERROR "固定上游源码缺少预期的语音适配入口：${msime_voice_source}")
  endif()
  set_property(SOURCE "${msime_voice_file}" APPEND PROPERTY COMPILE_OPTIONS "/FI${msime_voice_redirect}")
endforeach()

# 固定上游的 NCHWc 掩码在 x86 先按 32 位 size_t 取反，再零扩展为 64 位，且被 /WX 拒绝。
# 仅在构建目录生成修正副本，在取反前扩宽掩码；源码缓存保持原样。
if(CMAKE_SIZEOF_VOID_P EQUAL 4)
  set(msime_nchwc_source "${CMAKE_CURRENT_SOURCE_DIR}/../onnxruntime/core/optimizer/nchwc_transformer.cc")
  file(READ "${msime_nchwc_source}" msime_nchwc_content)
  string(REGEX MATCHALL "& ~\\(nchwc_block_size - 1\\)" msime_nchwc_matches "${msime_nchwc_content}")
  list(LENGTH msime_nchwc_matches msime_nchwc_count)
  if(NOT msime_nchwc_count EQUAL 3)
    message(FATAL_ERROR "固定 ONNX 源码的 NCHWc 掩码入口已变化，必须重新审查适配")
  endif()
  string(REPLACE "& ~(nchwc_block_size - 1)" "& ~static_cast<int64_t>(nchwc_block_size - 1)"
    msime_nchwc_content "${msime_nchwc_content}")
  set(msime_nchwc_generated "${CMAKE_CURRENT_BINARY_DIR}/msime-windows7/nchwc_transformer.cc")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/msime-windows7")
  file(WRITE "${msime_nchwc_generated}" "${msime_nchwc_content}")
  function(msime_replace_windows7_nchwc_source)
    get_target_property(msime_optimizer_sources onnxruntime_optimizer SOURCES)
    set(msime_replaced FALSE)
    set(msime_optimizer_fixed)
    foreach(msime_optimizer_source IN LISTS msime_optimizer_sources)
      if(msime_optimizer_source MATCHES "(^|/)nchwc_transformer\\.cc$")
        list(APPEND msime_optimizer_fixed "${msime_nchwc_generated}")
        set(msime_replaced TRUE)
      else()
        list(APPEND msime_optimizer_fixed "${msime_optimizer_source}")
      endif()
    endforeach()
    if(NOT msime_replaced)
      message(FATAL_ERROR "ONNX 优化器未包含预期的 NCHWc 编译单元")
    endif()
    set_property(TARGET onnxruntime_optimizer PROPERTY SOURCES "${msime_optimizer_fixed}")
  endfunction()
  cmake_language(DEFER CALL msime_replace_windows7_nchwc_source)
endif()
