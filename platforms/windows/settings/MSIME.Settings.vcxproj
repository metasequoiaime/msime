<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="RelWithDebInfo|x64"><Configuration>RelWithDebInfo</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{C4D0A6B5-E2CF-4EA5-9AF1-0B5A4DE0D7C2}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>MSIME.Settings</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsAppSDKVersion Condition="'$(WindowsAppSDKVersion)' == ''">1.7.260224002</WindowsAppSDKVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Visual Studio 2022 的 MSBuild 经 ImportAfter 引入旧的 Microsoft.NuGet.targets，它的 ResolveNuGetPackageAssets 按 project.json 时代的托管目标框架去 project.assets.json 里找目标；本工程没有 TargetFrameworkMoniker，找不到 native,Version=v0.0，构建以「序列不包含任何元素」失败。原生 PackageReference 的头文件、库和 WinRT 元数据由 obj\*.nuget.g.targets 导入的各包自带 targets 处理，不需要这一步。Visual Studio 2026（CI 用的）不再引入该文件，这里关掉也不影响它。 -->
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RelWithDebInfo|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup>
    <OutDir Condition="'$(OutDir)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutDir>
    <IntDir Condition="'$(IntDir)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\</IntDir>
    <HostApiInclude Condition="'$(HostApiInclude)' == ''">$(MSBuildProjectDirectory)\..\..\..\crates\host-api\include</HostApiInclude>
    <HostApiLibrary Condition="'$(HostApiLibrary)' == ''">msime_host_api.lib</HostApiLibrary>
    <!-- 本次构建的产品版本（shared/contracts/editions.json 的 id），选出 shared/contracts/msime_edition.h 里该版本的 CLSID、状态目录和方案；Build-Client.ps1 按 -Edition 传入，缺省是 full。 -->
    <MsimeEdition Condition="'$(MsimeEdition)' == ''">full</MsimeEdition>
    <!-- 本次构建的版本号，「关于」页显示并拿来检查更新；Build-Client.ps1 传入 TargetVersion，开发构建取 platforms/windows/version.txt，与 CMake 给 Server 的 MSIME_WINDOWS_VERSION 相同。 -->
    <MsimeVersion Condition="'$(MsimeVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\version.txt').Trim())</MsimeVersion>
    <!-- 本次构建的发布日期 YYYY-MM-DD，「关于」页显示在版本号后面。依次取环境变量 MSIME_RELEASE_DATE、platforms/windows/release-date.txt（只在源码包里有），都没有时由下面的 MsimeReleaseDate 目标取 git 当前提交的日期；仍然没有就为空，「关于」页只显示版本号。发布工作流从 main 的发版合并提交构建，所以 git 的日期就是发版当天。 -->
    <MsimeReleaseDate Condition="'$(MsimeReleaseDate)' == ''">$(MSIME_RELEASE_DATE)</MsimeReleaseDate>
    <MsimeReleaseDate Condition="'$(MsimeReleaseDate)' == '' and Exists('$(MSBuildProjectDirectory)\..\release-date.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\release-date.txt').Trim())</MsimeReleaseDate>
  </PropertyGroup>
  <!-- 优化构建只链接一次，不产生增量链接的 .ilk，并去掉未引用和相同的 COMDAT；只开 /DEBUG 时这两项都会被关掉。PDB 仍然生成，供符号发布资产使用。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'RelWithDebInfo' or '$(Configuration)' == 'Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(HostApiInclude);$(NativeDependenciesInclude);$(MSBuildProjectDirectory)\..\common;$(MSBuildProjectDirectory)\..\src\system;$(MSBuildProjectDirectory)\..\src\candidate;$(MSBuildProjectDirectory)\..\msimeui\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;MSIME_EDITION_$(MsimeEdition.ToUpperInvariant());MSIME_WINDOWS_VERSION=&quot;$(MsimeVersion)&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- advapi32、ole32 和 uuid 给 common/StateDirectory.h：注册表里安装器的 DataDir（RegGetValueW）、SHGetKnownFolderPath 返回值的释放（CoTaskMemFree）和 FOLDERID_LocalAppData，与 CMake 的 windows-state-directory 测试链接的相同。 -->
      <AdditionalDependencies>$(HostApiLibrary);windowsapp.lib;shell32.lib;user32.lib;advapi32.lib;ole32.lib;uuid.lib;d2d1.lib;dwrite.lib;windowscodecs.lib;shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'RelWithDebInfo' or '$(Configuration)' == 'Release'">
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="..\..\common\CrashRecorder.cpp" />
    <ClCompile Include="..\..\common\Telemetry.cpp" />
    <ClCompile Include="..\msimeui\src\AnimatedImage.cpp" />
    <ClCompile Include="..\src\system\ShellLauncher.cpp" />
    <ResourceCompile Include="Settings.rc" />
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.250303.1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- 共用遥测包装器使用与原生宿主相同的 nlohmann-json；由构建入口传入已准备的依赖前缀。 -->
  <Target Name="MsimeNativeDependencies" BeforeTargets="ClCompile">
    <Error Condition="'$(NativeDependenciesInclude)' == '' or !Exists('$(NativeDependenciesInclude)\nlohmann\json.hpp')" Text="NativeDependenciesInclude 必须指向含 nlohmann/json.hpp 的原生依赖 include 目录" />
  </Target>
  <!-- 求值阶段不能运行进程，git 回退只能放在目标里，所以 MSIME_WINDOWS_RELEASE_DATE 在编译前加到编译项上，而不是写进上面的 ItemDefinitionGroup。git 不在 PATH 上或不在仓库里时不报错，日期为空。Exec 经 cmd 批处理执行，%25%25 在批处理里是一个 %，git 收到的是 %cs。 -->
  <Target Name="MsimeReleaseDate" BeforeTargets="ClCompile">
    <Error Condition="'$(MsimeReleaseDate)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(MsimeReleaseDate)', '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))" Text="MSIME_RELEASE_DATE 或 release-date.txt 必须是 YYYY-MM-DD：$(MsimeReleaseDate)" />
    <Exec Condition="'$(MsimeReleaseDate)' == ''" Command="git -C &quot;$(MSBuildProjectDirectory)&quot; log -1 --format=%25%25cs 2&gt;nul" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="MsimeGitReleaseDate" />
      <Output TaskParameter="ExitCode" PropertyName="MsimeGitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(MsimeReleaseDate)' == '' and '$(MsimeGitExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MsimeGitReleaseDate)', '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))">
      <MsimeReleaseDate>$(MsimeGitReleaseDate)</MsimeReleaseDate>
    </PropertyGroup>
    <Message Importance="normal" Text="MSIME_WINDOWS_RELEASE_DATE=&quot;$(MsimeReleaseDate)&quot;" />
    <ItemGroup>
      <ClCompile>
        <PreprocessorDefinitions>%(PreprocessorDefinitions);MSIME_WINDOWS_RELEASE_DATE=&quot;$(MsimeReleaseDate)&quot;</PreprocessorDefinitions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
