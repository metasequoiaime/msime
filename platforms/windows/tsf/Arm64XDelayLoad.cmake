# ARM64EC 的最终链接必须保留原生半边的延迟导入，不能只带入对象与库。
# /LINKREPROFULLPATHRSP only records the files the ARM64 link took as input (one quoted absolute path per line, the module definition as /DEF:), never options such as /DELAYLOAD. The ARM64 pass delay-loads exactly the host DLL its MSIME_HOST_LIBRARY names (tsf/CMakeLists.txt derives MSIME_TSF_HOST_DLL_NAME from "<dll>.lib"), so the same rule applied to the import library in the response file recovers that delay import.
function(msime_arm64x_delay_load_options response output)
  file(STRINGS "${response}" lines)
  set(options)
  foreach(line IN LISTS lines)
    string(REPLACE "\"" "" line "${line}")
    if(line MATCHES "(^|[/\\\\])([^/\\\\]+\\.[Dd][Ll][Ll])\\.[Ll][Ii][Bb]$")
      list(APPEND options "/DELAYLOAD:${CMAKE_MATCH_2}")
    endif()
  endforeach()
  list(LENGTH options count)
  if(count EQUAL 0)
    message(FATAL_ERROR "${response} lists no ARM64 host import library (<dll>.lib) to delay-load; rebuild the ARM64 pass")
  elseif(NOT count EQUAL 1)
    message(FATAL_ERROR "${response} lists ${count} ARM64 host import libraries (${options}) where the ARM64 pass links one; rebuild the ARM64 pass")
  endif()
  set(${output} "${options}" PARENT_SCOPE)
endfunction()
