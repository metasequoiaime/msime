# ARM64EC 的最终链接必须保留原生半边的延迟导入，不能只带入对象与库。
function(msime_arm64x_delay_load_options response output)
  file(STRINGS "${response}" lines)
  set(options)
  foreach(line IN LISTS lines)
    string(REPLACE "\"" "" line "${line}")
    if(line MATCHES "^/[Dd][Ee][Ll][Aa][Yy][Ll][Oo][Aa][Dd]:([A-Za-z0-9_.-]+\\.dll)$")
      list(APPEND options "/DELAYLOAD:${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT options)
    message(FATAL_ERROR "${response} lists no ARM64 delay imports; rebuild the ARM64 pass")
  endif()
  set(${output} "${options}" PARENT_SCOPE)
endfunction()
