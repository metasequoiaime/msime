set(msime_tsf_capture_source "${CMAKE_CURRENT_LIST_DIR}")
add_library(msime-tsf-capture-test-host SHARED "${msime_tsf_capture_source}/tests/runtime/tsf_capture_host.cpp" "${msime_tsf_capture_source}/tests/runtime/tsf_capture_host.def")
foreach(index RANGE ${msime_edition_last})
  string(JSON id GET "${msime_editions_json}" editions ${index} id)
  if(id STREQUAL MSIME_EDITION)
    string(JSON capture_host_dll GET "${msime_editions_json}" editions ${index} platforms windows host_dll)
  endif()
endforeach()
get_filename_component(capture_host_name "${capture_host_dll}" NAME_WE)
set_target_properties(msime-tsf-capture-test-host PROPERTIES PREFIX "" OUTPUT_NAME "${capture_host_name}")
target_link_libraries(msime-tsf-capture-test-host PRIVATE nlohmann_json::nlohmann_json)
add_library(msime-tsf-capture-test-tip SHARED "${msime_tsf_capture_source}/TsfCrashCapture.cpp" "${msime_tsf_capture_source}/tests/runtime/tsf_capture_fixture.cpp" "${msime_tsf_capture_source}/tests/runtime/tsf_capture_fixture.def")
set_target_properties(msime-tsf-capture-test-tip PROPERTIES PREFIX "" OUTPUT_NAME MetasequoiaImeTsfLeaseTest)
target_compile_definitions(msime-tsf-capture-test-tip PRIVATE MSIME_TSF_CRASH_CAPTURE_TEST=1)
target_include_directories(msime-tsf-capture-test-tip PRIVATE "${MSIME_TSF_VERSION_INCLUDE_DIR}" "${msime_tsf_capture_source}/../../../crates/host-api/include")
target_link_libraries(msime-tsf-capture-test-tip PRIVATE msime-tsf-capture-test-host nlohmann_json::nlohmann_json)
add_executable(msime-tsf-capture-lifecycle-test "${msime_tsf_capture_source}/tests/runtime/tsf_capture_lifecycle.cpp")
add_executable(msime-tsf-capture-system-test "${msime_tsf_capture_source}/tests/runtime/tsf_capture_system.cpp")
target_link_libraries(msime-tsf-capture-system-test PRIVATE nlohmann_json::nlohmann_json)
add_dependencies(msime-tsf-capture-lifecycle-test msime-tsf-capture-test-tip msime-tsf-crash-wer)
add_dependencies(msime-tsf-capture-system-test msime-tsf-capture-lifecycle-test)
add_custom_command(TARGET msime-tsf-capture-lifecycle-test POST_BUILD
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:msime-tsf-crash-wer>" "$<TARGET_FILE_DIR:msime-tsf-capture-lifecycle-test>")
foreach(target IN ITEMS msime-tsf-capture-test-host msime-tsf-capture-test-tip msime-tsf-capture-lifecycle-test msime-tsf-capture-system-test)
  set_target_properties(${target} PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/capture-test-payload"
    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/capture-test-payload"
    ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/capture-test-payload")
  foreach(config IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set_target_properties(${target} PROPERTIES
      RUNTIME_OUTPUT_DIRECTORY_${config} "${CMAKE_CURRENT_BINARY_DIR}/capture-test-payload/${config}"
      LIBRARY_OUTPUT_DIRECTORY_${config} "${CMAKE_CURRENT_BINARY_DIR}/capture-test-payload/${config}"
      ARCHIVE_OUTPUT_DIRECTORY_${config} "${CMAKE_CURRENT_BINARY_DIR}/capture-test-payload/${config}")
  endforeach()
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    target_link_options(${target} PRIVATE -static)
    if(target STREQUAL "msime-tsf-capture-system-test")
      target_link_options(${target} PRIVATE -municode)
    endif()
  endif()
endforeach()
add_test(NAME msime-tsf-capture-lifecycle COMMAND msime-tsf-capture-lifecycle-test)
set_tests_properties(msime-tsf-capture-lifecycle PROPERTIES TIMEOUT 45)
