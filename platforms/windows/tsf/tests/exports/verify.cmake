if(MODE STREQUAL "dumpbin")
  set(flag /exports)
else()
  set(flag -p)
endif()
execute_process(COMMAND "${INSPECTOR}" "${flag}" "${DLL}"
  RESULT_VARIABLE status OUTPUT_VARIABLE exports ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "PE export inspection failed: ${error}")
endif()
foreach(symbol DllGetClassObject DllCanUnloadNow DllRegisterServer DllUnregisterServer)
  if(NOT exports MATCHES "[ \t]${symbol}([ \t\r\n]|$)")
    message(FATAL_ERROR "Missing undecorated COM entry: ${symbol}")
  endif()
endforeach()
if(MODE STREQUAL "objdump")
  # RT_GROUP_ICON = 14: one group per original ICO, not one per bitmap size.
  if(NOT exports MATCHES "Entry: ID: 0x00000e[^\n]*\n[^\n]*IDs: 29")
    message(FATAL_ERROR "Expected twenty-nine embedded TSF icon groups")
  endif()
endif()
