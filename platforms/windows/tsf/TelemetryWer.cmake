set(msime_wer_source "${CMAKE_CURRENT_LIST_DIR}")
add_library(msime-tsf-crash-wer SHARED "${msime_wer_source}/TelemetryWer.cpp" "${msime_wer_source}/TelemetryWer.def")
target_compile_features(msime-tsf-crash-wer PRIVATE cxx_std_17)
target_link_libraries(msime-tsf-crash-wer PRIVATE advapi32)
set_target_properties(msime-tsf-crash-wer PROPERTIES OUTPUT_NAME MetasequoiaImeCrashWer PREFIX "")
add_executable(msime-tsf-telemetry-wer-test "${msime_wer_source}/tests/runtime/telemetry_wer.cpp")
target_compile_features(msime-tsf-telemetry-wer-test PRIVATE cxx_std_17)
add_dependencies(msime-tsf-telemetry-wer-test msime-tsf-crash-wer)
foreach(wer_target IN ITEMS msime-tsf-crash-wer msime-tsf-telemetry-wer-test)
  if(MSVC)
    target_compile_options(${wer_target} PRIVATE /W4 /WX)
    target_compile_definitions(${wer_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
    set_property(TARGET ${wer_target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  else()
    target_compile_options(${wer_target} PRIVATE -Wall -Wextra -Werror)
    # helper 由系统进程加载，不依赖产品目录中的 MinGW 运行时 DLL。
    target_link_options(${wer_target} PRIVATE -static)
  endif()
endforeach()
add_test(NAME msime-tsf-telemetry-wer COMMAND msime-tsf-telemetry-wer-test)
set_tests_properties(msime-tsf-telemetry-wer PROPERTIES TIMEOUT 30)

# WER 与 TIP 一起使用 Arm64X，系统无论选择原生还是模拟报告进程都能加载同一路径。
if(MSIME_TSF_ARM64X)
  if(NOT MSVC OR NOT IS_ABSOLUTE "${MSIME_TSF_ARM64X_RESPONSE}")
    message(FATAL_ERROR "WER Arm64X requires MSVC and the TIP response path")
  endif()
  get_filename_component(msime_wer_response_dir "${MSIME_TSF_ARM64X_RESPONSE}" DIRECTORY)
  set(msime_wer_response "${msime_wer_response_dir}/msime-wer-arm64.rsp")
  if(MSIME_TSF_ARM64X STREQUAL "ARM64")
    file(MAKE_DIRECTORY "${msime_wer_response_dir}")
    target_link_options(msime-tsf-crash-wer PRIVATE "/LINKREPROFULLPATHRSP:${msime_wer_response}")
  elseif(MSIME_TSF_ARM64X STREQUAL "ARM64EC")
    if(NOT EXISTS "${msime_wer_response}")
      message(FATAL_ERROR "Build the native WER pass first: ${msime_wer_response}")
    endif()
    file(STRINGS "${msime_wer_response}" msime_wer_objects REGEX "obj\"$")
    file(STRINGS "${msime_wer_response}" msime_wer_libraries REGEX "lib\"$")
    file(STRINGS "${msime_wer_response}" msime_wer_definition REGEX "def\"$")
    if(NOT msime_wer_objects OR NOT msime_wer_definition)
      message(FATAL_ERROR "Native WER response lacks objects or definition")
    endif()
    string(REPLACE "\"" "" msime_wer_objects "${msime_wer_objects}")
    string(REPLACE "\"" "" msime_wer_libraries "${msime_wer_libraries}")
    string(REPLACE "\"" "" msime_wer_definition "${msime_wer_definition}")
    string(REGEX REPLACE "^/[Dd][Ee][Ff]:" "/DEFARM64NATIVE:" msime_wer_definition "${msime_wer_definition}")
    target_sources(msime-tsf-crash-wer PRIVATE ${msime_wer_objects})
    string(REGEX REPLACE "/[Mm][Aa][Cc][Hh][Ii][Nn][Ee]:[Aa][Rr][Mm]64[Ee][Cc]" "" CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS}")
    target_link_options(msime-tsf-crash-wer PRIVATE /MACHINE:ARM64X "${msime_wer_definition}" ${msime_wer_libraries})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${msime_wer_response}")
  else()
    message(FATAL_ERROR "Unknown WER Arm64X pass: ${MSIME_TSF_ARM64X}")
  endif()
endif()
