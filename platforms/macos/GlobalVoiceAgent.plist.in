<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>@MSIME_GLOBAL_VOICE_LABEL@</string>
  <key>BundleProgram</key><string>Contents/MacOS/@MSIME_INPUT_METHOD_NAME@</string>
  <key>ProgramArguments</key><array><string>@MSIME_INPUT_METHOD_NAME@</string><string>--global-voice-bootstrap</string></array>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
