<?xml version="1.0" encoding="utf-8"?>
<!-- macOS 安装包的分发文件模板，由 platforms/macos/scripts/installer_package.py render 按版本渲染，productbuild 用它把组件包打成发布用的 pkg。为什么这样配见 .agents/notes/implemented/process/2026-11-02-macos-pkg-only.md。 -->
<installer-gui-script minSpecVersion="2">
    <!-- 标题按系统语言取 resources/<语言>.lproj/Localizable.strings 里的 SU_TITLE。 -->
    <title>SU_TITLE</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <!-- 包里是 universal 的应用：hostArchitectures 不含 arm64 时，Apple 芯片的 Mac 会在 Rosetta 下评估分发文件、运行脚本。 -->
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <!-- 只装到本机的「应用程序」（需要管理员授权）。不开「仅为我安装」：安装位置、postinstall 和 Homebrew cask 的路径都只认 /Applications。 -->
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="@IDENTIFIER@"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="@IDENTIFIER@" visible="false">
        <pkg-ref id="@IDENTIFIER@"/>
    </choice>
    <!-- 不加 onConclusion="RequireLogout"：只有第一次安装需要重新登录，结束页里写明。 -->
    <pkg-ref id="@IDENTIFIER@" version="@VERSION@" onConclusion="none">#@COMPONENT@</pkg-ref>
    <!-- 正在运行的设置应用要先退出，否则旧进程继续跑旧代码。must-close 只在 pkg-ref 下生效。 -->
    <pkg-ref id="@IDENTIFIER@">
        <must-close>
            <app id="@SETTINGS_BUNDLE_ID@"/>
        </must-close>
    </pkg-ref>
</installer-gui-script>
