static void TestQuickPhraseHotkeyRouting() {
    NSString *suite = [@"msime.quick-phrase-hotkey." stringByAppendingString:NSUUID.UUID.UUIDString];
    NSUserDefaults *defaults = [[NSUserDefaults alloc] initWithSuiteName:suite];
    MSIMEAppearancePreferences *appearance = [[MSIMEAppearancePreferences alloc] initWithDefaults:defaults];
    ModeController *controller = [ModeController alloc];
    ShortcutClient *client = [ShortcutClient new];
    ShortcutSession *session = [ShortcutSession new];
    [controller setValue:appearance forKey:@"appearance"];
    [controller setValue:client forKey:@"activeClient"];
    [controller setValue:session forKey:@"session"];
    NSDictionary *idle = @{@"local_mode":@"none", @"editing_text":@"", @"candidates":@[]};
    NSDictionary *quick = @{@"local_mode":@"quick_phrase", @"editing_text":@"K", @"candidates":@[]};
    [controller setValue:idle forKey:@"view"];
    appearance.englishMode = YES;
    assert(![controller handleEvent:ModeKey(40, NSEventModifierFlagControl, NO) client:client]);
    assert(session.commandCalls == 0);
    [appearance applySharedInputPreferences:@{@"keybindings":@{@"enter_quick_phrase":@"Ctrl+KeyK"}}];
    session.nextTransition = @{@"handled":@YES, @"commit":NSNull.null, @"view":quick};
    assert([controller handleEvent:ModeKey(40, NSEventModifierFlagControl, NO) client:client]);
    assert(session.lastCommand == MSIME_ENTER_QUICK_PHRASE && appearance.englishMode);
    assert([controller quickPhraseModeActive]);
    const NSUInteger commands = session.commandCalls;
    assert([controller handleEvent:ModeKey(40, NSEventModifierFlagControl, YES) client:client]);
    assert(session.commandCalls == commands && [controller quickPhraseModeActive]);
    const NSUInteger before = session.asciiCalls;
    assert([controller handleEvent:ModeKey(0, 0, NO) client:client]);
    assert(session.asciiCalls == before + 1 && appearance.englishMode);
    session.nextTransition = @{@"handled":@YES, @"commit":NSNull.null, @"view":idle};
    assert([controller handleEvent:ModeKey(53, 0, NO) client:client]);
    assert(![controller quickPhraseModeActive] && appearance.englishMode);
    assert(![controller handleEvent:ModeKey(0, 0, NO) client:client]);
    assert(session.asciiCalls == before + 1);
    controller.secureInput = YES;
    assert(![controller handleQuickPhraseHotkey:ModeKey(40, NSEventModifierFlagControl, NO)]);
    controller.secureInput = NO;
    [appearance applySharedLocalModes:@{@"quick_phrase":@NO}];
    assert(![controller handleQuickPhraseHotkey:ModeKey(40, NSEventModifierFlagControl, NO)]);
    [appearance applySharedLocalModes:@{@"quick_phrase":@YES}];
    [controller setValue:quick forKey:@"view"];
    assert(![controller handleQuickPhraseHotkey:ModeKey(40, NSEventModifierFlagControl, NO)]);
    [controller setValue:idle forKey:@"view"];
    [controller setValue:@YES forKey:@"englishOnlineCandidatesEnabled"];
    [controller setValue:@YES forKey:@"managedEnglishComposition"];
    session.dedicatedEnglish = YES;
    [controller setValue:@{@"editing_text":@"", @"dedicated_english":@YES} forKey:@"view"];
    session.nextTransition = @{@"handled":@YES, @"commit":NSNull.null, @"view":quick};
    assert([controller handleEvent:ModeKey(40, NSEventModifierFlagControl, NO) client:client]);
    assert(!session.dedicatedEnglish && ![[controller valueForKey:@"managedEnglishComposition"] boolValue]);
    assert([controller quickPhraseModeActive] && appearance.englishMode);
    const NSUInteger switches = session.englishCandidateCalls;
    assert([controller handleEvent:ModeKey(0, 0, NO) client:client]);
    assert(session.englishCandidateCalls == switches);
    session.nextTransition = @{@"handled":@YES, @"commit":NSNull.null, @"view":idle};
    assert([controller handleEvent:ModeKey(53, 0, NO) client:client]);
    session.nextTransition = nil;
    [controller handleEvent:ModeKey(0, 0, NO) client:client];
    assert(session.dedicatedEnglish && [[controller valueForKey:@"managedEnglishComposition"] boolValue]);
    assert(appearance.englishMode);
    MSIMERemoveTestPreferenceSuite(defaults, suite);
}
