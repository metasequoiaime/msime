# 本次构建的产品版本（shared/contracts/editions.json 的 id）。platforms/linux/src/core/LinuxEdition.h 按这里定义的 MSIME_EDITION_<ID> 选出该版本的每用户目录、IBus 引擎名、Fcitx5 插件名和命令名，所以每个版本各编一次。缺省是 full，与引入版本之前的构建完全相同：同样的前缀、同样的文件和名字，脚本与数据文件原样安装。
#
# 其他版本是独立的包，装在自己的前缀（版本表的 install_prefix，/opt/msime-linux-<id>）下。CMAKE_INSTALL_PREFIX 等于这个前缀时（打包就是这样），系统按名字查找的那几样（IBus 组件、Fcitx5 插件与条目、systemd 用户单元、桌面入口、XDG 自启动项、图标和 /usr/bin 下的两个命令）装到系统目录；开发时换成别的前缀则全部留在前缀里，不碰系统目录。脚本和数据文件在配置阶段由 platforms/linux/scripts/edition_linux.py 按版本改写一份再安装。
include_guard(GLOBAL)
set(MSIME_EDITION "full" CACHE STRING "Product edition to build (an id in shared/contracts/editions.json with a Linux section)")
set(MSIME_EDITIONS_JSON "${CMAKE_CURRENT_LIST_DIR}/../../../shared/contracts/editions.json")
file(READ "${MSIME_EDITIONS_JSON}" msime_editions_json)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MSIME_EDITIONS_JSON}")
string(JSON msime_edition_count LENGTH "${msime_editions_json}" editions)
set(msime_edition_index_found "")
set(msime_edition_ids "")
math(EXPR msime_edition_last "${msime_edition_count} - 1")
foreach(msime_edition_index RANGE ${msime_edition_last})
  string(JSON msime_edition_id GET "${msime_editions_json}" editions ${msime_edition_index} id)
  string(JSON msime_edition_linux TYPE "${msime_editions_json}" editions ${msime_edition_index} platforms linux)
  if(msime_edition_linux STREQUAL "OBJECT")
    list(APPEND msime_edition_ids "${msime_edition_id}")
    if(msime_edition_id STREQUAL MSIME_EDITION)
      set(msime_edition_index_found "${msime_edition_index}")
    endif()
  endif()
endforeach()
if(msime_edition_index_found STREQUAL "")
  message(FATAL_ERROR "MSIME_EDITION=${MSIME_EDITION} is not an edition with Linux identifiers; choose one of: ${msime_edition_ids}")
endif()
string(TOUPPER "${MSIME_EDITION}" msime_edition_macro)
add_compile_definitions(MSIME_EDITION_${msime_edition_macro})

# 版本表 platforms.linux 的字段。
foreach(msime_edition_field package install_prefix client_directory ibus_engine fcitx5_addon tauri_identifier)
  string(TOUPPER "${msime_edition_field}" msime_edition_variable)
  string(JSON MSIME_EDITION_${msime_edition_variable} GET "${msime_editions_json}"
         editions ${msime_edition_index_found} platforms linux ${msime_edition_field})
endforeach()
string(JSON MSIME_EDITION_DISPLAY_NAME GET "${msime_editions_json}" editions ${msime_edition_index_found} display_name zh-Hans)
string(JSON MSIME_EDITION_DISPLAY_NAME_EN GET "${msime_editions_json}" editions ${msime_edition_index_found} display_name en)
string(JSON msime_edition_language_dictionaries LENGTH "${msime_editions_json}"
       editions ${msime_edition_index_found} language_dictionaries)
# 每用户目录名，也是前缀下 share、lib、doc 和 /etc 里的子目录名；full 是 msime-client。
set(MSIME_CLIENT_DIRECTORY "${MSIME_EDITION_CLIENT_DIRECTORY}")
if(MSIME_EDITION STREQUAL "full")
  set(MSIME_EDITION_IS_FULL ON)
  set(MSIME_EDITION_RESOURCE_LOCK "${CMAKE_CURRENT_LIST_DIR}/../../../resources/desktop-dictionary.lock.json")
else()
  set(MSIME_EDITION_IS_FULL OFF)
  set(MSIME_EDITION_RESOURCE_LOCK "${CMAKE_CURRENT_LIST_DIR}/../../../resources/editions/${MSIME_EDITION}.lock.json")
endif()
# 本版本是否用到粤语、注音词库；不用的版本不装它们。
if(msime_edition_language_dictionaries GREATER 0)
  set(MSIME_EDITION_LANGUAGE_DICTIONARIES ON)
else()
  set(MSIME_EDITION_LANGUAGE_DICTIONARIES OFF)
endif()
# 是否把系统按名字查找的文件装到系统目录：只有不是 full、而且前缀就是版本自己的前缀时。full 的这些文件今天就在 /usr 前缀下的相对位置，不变。
if(NOT MSIME_EDITION_IS_FULL AND CMAKE_INSTALL_PREFIX STREQUAL MSIME_EDITION_INSTALL_PREFIX)
  set(MSIME_EDITION_SYSTEM_PATHS ON)
  set(MSIME_SYSTEM_DATADIR "/usr/share")
  set(MSIME_SYSTEM_FULL_DATADIR "/usr/share")
else()
  set(MSIME_EDITION_SYSTEM_PATHS OFF)
  set(MSIME_SYSTEM_DATADIR "${CMAKE_INSTALL_DATADIR}")
  set(MSIME_SYSTEM_FULL_DATADIR "${CMAKE_INSTALL_FULL_DATADIR}")
endif()
if(NOT MSIME_EDITION_IS_FULL)
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
endif()

# 本版本要安装的那份脚本或数据文件，路径写进 <variable>。full 就是仓库里的文件；其他版本是 edition_linux.py 改写的副本，规则没有全部命中或留下 full 的名字时配置失败。
function(msime_edition_source variable relative)
  set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../${relative}")
  if(MSIME_EDITION_IS_FULL)
    set(${variable} "${source}" PARENT_SCOPE)
    return()
  endif()
  set(output "${CMAKE_BINARY_DIR}/edition/${relative}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/edition_linux.py")
  execute_process(
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/edition_linux.py"
            render --edition "${MSIME_EDITION}" --input "${source}" --output "${output}"
    RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot render ${relative} for edition ${MSIME_EDITION}")
  endif()
  set(${variable} "${output}" PARENT_SCOPE)
endfunction()
