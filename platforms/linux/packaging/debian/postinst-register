# 由 debian/rules 接在 CMake 配置出的 postinst 之后、#DEBHELPER# 之前。
#
# 本包以 Conflicts/Replaces 替换发布页的 msime-linux 时，dpkg 以 `prerm remove in-favour msime …` 调用后者的 prerm：它对每个已登录用户停用 MSIME 的用户单元并运行 msime-linux-setup --unregister，输入法从 IBus 与 Fcitx5 的列表里消失。上面那部分只重启仍在运行的服务，恢复不了这些，所以本包第一次配置时（$2 为空）替每个用户以临时单元运行 msime-linux-setup --register；没配置过的用户它什么也不做。dpkg 不告诉 postinst 这次安装替换了谁，所以没装过 msime-linux、但卸掉它时保留了配置的用户也会被恢复，这与重新装上输入法的意图一致。任何失败都不能让事务失败。
if [ "$1" = configure ] && [ -z "$2" ] && command -v loginctl >/dev/null 2>&1 && command -v systemd-run >/dev/null 2>&1; then
  register_users=$(loginctl list-users --no-legend 2>/dev/null) || register_users=
  while read -r uid name _; do
    case "$uid" in
      ''|*[!0-9]*) continue ;;
    esac
    systemd-run --user -M "$uid@" --wait --collect --quiet /usr/bin/msime-linux-setup --register </dev/null >/dev/null 2>&1 ||
      echo "msime: could not restore MSIME for ${name:-uid $uid}; that user should run: msime-linux-setup --register" >&2
  done <<REGISTER_EOF
$register_users
REGISTER_EOF
fi

