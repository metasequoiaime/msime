version=4
# 源码包与 vendor 组件包都由 release-linux.yml 在 main 上的正式版发布时传到滚动的 linux-sources release，每个版本一组，不在版本发布页 linux-vVERSION 上。GitHub 的发布页面由脚本渲染，这里读发布 API 里这一个 release 的 JSON：它列出全部资产的下载地址，不会像发布列表那样随着别的发布增多被挤到后面的页上。
opts="searchmode=plain" \
  https://api.github.com/repos/metasequoiaime/msime/releases/tags/linux-sources \
  https://github.com/metasequoiaime/msime/releases/download/linux-sources/msime-([\d.]+)\.tar\.xz
opts="searchmode=plain,component=vendor" \
  https://api.github.com/repos/metasequoiaime/msime/releases/tags/linux-sources \
  https://github.com/metasequoiaime/msime/releases/download/linux-sources/msime-([\d.]+)-vendor\.tar\.xz same
