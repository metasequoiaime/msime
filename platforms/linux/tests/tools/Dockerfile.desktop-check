# The image scripts/verify-local.sh runs `cargo check -p msime-desktop` in: the Tauri desktop shell's build dependencies on the same pinned base as Dockerfile.build-gate. It used to install these with apt inside a throwaway container on every run, including --quick and the pre-push hook; baked into an image, the apt step is paid once and repeated only when this file changes.
#
# webkit2gtk, gtk3, libsoup and javascriptcoregtk are what the Tauri shell links; libasound2-dev is what cpal's ALSA backend links, which msime-desktop pulls in through the Host API, and alsa-sys finds it with pkg-config. SQLite is compiled in by rusqlite's bundled feature, so no system package is needed for it. Kept separate from the build-gate and packaging images so the native host's compile gate does not gain packages it does not build against.
FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
RUN apt-get update && apt-get install -y --no-install-recommends \
  libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
  pkg-config libssl-dev libasound2-dev \
  && rm -rf /var/lib/apt/lists/*
# 仓库工具链声明要求这两个组件，预装后临时容器不再逐次补装；保留上面的 apt 缓存层。
RUN rustup component add rustfmt clippy
WORKDIR /source
