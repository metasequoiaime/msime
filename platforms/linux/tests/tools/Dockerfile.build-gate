# The compile gate for the Linux native host: every development package the
# CMake project looks for, so an optional path cannot be skipped by accident and
# then rot. Distinct from Dockerfile beside it, which is the isolated acceptance
# image and deliberately stays closer to a plain desktop; adding X11, XFixes and
# Fcitx5 there would change what that run builds without making its result any
# more trustworthy.
#
# No locked dictionaries and no daemons: this image compiles and runs the unit
# tests, which is what a pre-merge gate can honestly check. dbus is here only so
# the engine smoke can be run by hand against a locked resource directory
# without installing it into the container on every run.
FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
RUN apt-get update && apt-get install -y --no-install-recommends \
  cmake ninja-build pkg-config python3 \
  libasound2-dev \
  libibus-1.0-dev libxkbcommon-dev nlohmann-json3-dev \
  libwayland-dev wayland-protocols libx11-dev libxfixes-dev libxrandr-dev \
  libfcitx5core-dev libfcitx5utils-dev libfcitx5config-dev libcairo2-dev \
  fcitx5-modules libpango1.0-dev \
  dbus dbus-bin xvfb xauth \
  && rm -rf /var/lib/apt/lists/*
# xvfb 和 xauth 只给 ibus-mode-hint-x11-badge* 用：IBus 切换徽章的 X11 那条路要一个 X 服务器，xvfb-run 在单个测试里起停，镜像里不常驻任何服务。
# 仓库工具链声明要求这两个组件，预装后临时容器不再逐次补装；保留上面的 apt 缓存层。
RUN rustup component add rustfmt clippy
WORKDIR /source
