# Fcitx5 acceptance image. Keep the base image pinned in Dockerfile so the normal Linux checks and the Fcitx5 checks share the same Rust toolchain.
ARG BASE_IMAGE=msime-linux-linux-test:local
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    fcitx5 fcitx5-modules fcitx5-frontend-gtk3 \
    libfcitx5core-dev libfcitx5utils-dev libfcitx5config-dev \
    libgtk-3-dev libdbus-1-dev dbus-x11 python3-dbus python3-gi python3-pil grim fonts-noto-cjk xcompmgr && \
    rm -rf /var/lib/apt/lists/*
