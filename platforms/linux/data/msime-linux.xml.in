<?xml version="1.0" encoding="UTF-8"?>
<component>
  <name>msime-linux</name>
  <description>MSIME Linux input method</description>
  <exec>&quot;@CMAKE_INSTALL_FULL_BINDIR@/msime-linux-ibus-launcher&quot; &quot;@CMAKE_INSTALL_FULL_SYSCONFDIR@/msime-client/runtime-options.json&quot;</exec>
  <version>0.1.0</version>
  <author>MSIME contributors</author>
  <license>GPL-3.0-only</license>
  <homepage>https://github.com/metasequoiaime/msime</homepage>
  <textdomain>msime-client</textdomain>
  <engines>
    <engine>
      <name>msime-linux</name>
      <longname>Metasequoia 水杉输入法</longname>
      <description>Shared MSIME Linux input runtime</description>
      <language>zh</language>
      <license>GPL-3.0-only</license>
      <author>MSIME contributors</author>
      <icon>msime-client</icon>
      <!-- default 表示切到本输入法时不改当前键盘布局：IBus 面板和 GNOME Shell 都会把引擎写的具体布局（例如 us）套到键盘上，Dvorak、Colemak 用户切过来就被换回 QWERTY（#6365）。按键按布局翻译后的 keyval 处理，不依赖 us。 -->
      <layout>default</layout>
    </engine>
  </engines>
</component>
