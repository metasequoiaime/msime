import QtQuick
import Quickshell
import Quickshell.Io
import qs.Commons
import qs.Ui

// Omarchy starts fcitx5 with --disable notificationitem, so the tray that would show MSIME's 中/英 label and menu never appears. This widget reads the status the addon publishes (src/core/InputStatus.h) and stands in for both.
BarWidget {
  id: root
  moduleName: "metasequoia.msime"

  readonly property var schemeNames: ({ quanpin: "全拼", shuangpin: "双拼", wubi: "五笔", cantonese: "粤拼", zhuyin: "注音", japanese: "日文", korean: "韩文", vietnamese: "越南文" })
  property bool active: false
  property string label: ""
  property string scheme: ""
  // Switching focus between two windows deactivates one context before activating the next, so a brief active:false is not shown; only one that lasts hides the widget.
  property bool shown: false

  function apply(text) {
    var status
    try { status = JSON.parse(text) } catch (e) { status = null }
    root.active = !!(status && status.active === true && status.label)
    if (root.active) {
      root.label = String(status.label)
      root.scheme = String(status.scheme || "")
      hideDelay.stop()
      root.shown = true
    } else if (root.shown && !hideDelay.running) {
      hideDelay.start()
    }
  }

  function run(command) {
    if (root.bar) root.bar.run(command)
  }

  visible: shown
  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight

  FileView {
    id: statusFile
    path: Quickshell.env("XDG_RUNTIME_DIR") + "/msime-client/input-status.json"
    printErrors: false
    onLoaded: root.apply(text())
    onLoadFailed: root.apply("")
  }

  // The addon replaces the file by rename, which a file watcher loses track of; the file is a few bytes on tmpfs, so polling is the dependable way to follow it.
  Timer {
    interval: 300
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: statusFile.reload()
  }

  Timer {
    id: hideDelay
    interval: 400
    onTriggered: root.shown = root.active
  }

  WidgetButton {
    id: button
    anchors.fill: parent
    bar: root.bar
    text: root.label
    fontSize: Style.font.caption
    horizontalMargin: 6
    tooltipText: "水杉输入法" + (root.scheme ? " · " + (root.schemeNames[root.scheme] || root.scheme) : "")
    onPressed: function(pressed) {
      if (pressed === Qt.MiddleButton) root.run(Util.shellQuote("@CMAKE_INSTALL_FULL_BINDIR@/msime-linux-settings"))
      else root.run(Util.shellQuote("@CMAKE_INSTALL_FULL_DATADIR@/msime-client/omarchy/menu"))
    }
  }
}
