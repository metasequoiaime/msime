# 取消竞态不需要模型或网络，三桌面共用相同的原生适配器测试。
find_package(Threads REQUIRED)
add_executable(common-embedded-translation-test "${CMAKE_CURRENT_LIST_DIR}/embedded_translation.cpp")
target_include_directories(common-embedded-translation-test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../../crates/host-api/include")
target_link_libraries(common-embedded-translation-test PRIVATE Threads::Threads)
if(MSVC)
  target_compile_options(common-embedded-translation-test PRIVATE /W4 /WX /UNDEBUG /utf-8)
else()
  target_compile_options(common-embedded-translation-test PRIVATE -Wall -Wextra -Werror -UNDEBUG)
endif()
add_test(NAME common-embedded-translation COMMAND common-embedded-translation-test)

add_executable(common-local-translation-settings-test "${CMAKE_CURRENT_LIST_DIR}/local_translation_settings.cpp")
target_compile_features(common-local-translation-settings-test PRIVATE cxx_std_17)
target_include_directories(common-local-translation-settings-test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../../crates/host-api/include")
target_link_libraries(common-local-translation-settings-test PRIVATE Threads::Threads nlohmann_json::nlohmann_json)
if(MSVC)
  target_compile_options(common-local-translation-settings-test PRIVATE /W4 /WX /UNDEBUG /utf-8)
else()
  target_compile_options(common-local-translation-settings-test PRIVATE -Wall -Wextra -Werror -UNDEBUG)
endif()
add_test(NAME common-local-translation-settings COMMAND common-local-translation-settings-test)
