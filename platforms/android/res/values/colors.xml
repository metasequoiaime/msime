<?xml version="1.0" encoding="utf-8"?>
<!-- 全平台设计稿 Android 一栏的颜色令牌（浅色）。深色同名令牌在 values-night/colors.xml。宿主页面应当读主题属性（res/values/themes.xml 的 M3 角色与 ?attr/ms*），季节由 ThemeOverlay.MSIME.Season.* 叠加；这里的 ms_<季节>_* 是那几层叠加的取值，ms_* 不带季节的是基础主题（秋杉）。季节色由 settings/AppThemePalette.java 的同一套公式算出，改公式或种子时两边一起改。输入法进程不用 R，它自己从 AppThemePalette 取色。 -->
<resources>
    <!-- ==== 不随应用主题变化的中性色 ==== -->
    <color name="ms_text">#191C19</color>
    <color name="ms_sub">#414941</color>
    <color name="ms_outline">#717970</color>
    <color name="ms_switch_off">#DFE4DB</color>
    <color name="ms_kb_sub">#56685A</color>
    <color name="ms_kb_hair">#1F000000</color>
    <color name="ms_press">#12000000</color>
    <color name="ms_hover">#0D000000</color>
    <color name="ms_toast_bg">#1C1C1E</color>
    <color name="ms_toast_fg">#FFFFFF</color>
    <!-- 「设为默认输入法」尚未完成那一项的橙点。 -->
    <color name="ms_warn">#FF9500</color>
    <!-- 退出登录、注销账号这类破坏性操作。 -->
    <color name="ms_danger">#FF3B30</color>
    <!-- sheet 与对话框背后的遮罩。 -->
    <color name="ms_scrim">#59000000</color>

