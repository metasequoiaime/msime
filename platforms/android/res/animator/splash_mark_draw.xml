<?xml version="1.0" encoding="utf-8"?>
<!-- 笔画自己走一遍：trimPathEnd 从 0 到 1，看起来像有人正在把这个标写出来。Timed as the design's msDraw: 1.05 s, starting 0.4 s in, once the mark has popped into place. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="trimPathEnd"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType"
    android:duration="1050"
    android:startOffset="400"
    android:interpolator="@anim/splash_draw" />
