<?xml version="1.0" encoding="utf-8"?>
<!-- One dictionary, phrase pack or reply template: a row of the grouped card the design draws these kinds in. CommunityAdapter paints the card behind each row (rounded at the group's ends) and hides the hairline above the first one. The glyph badge carries the name's first character; the subtitle is 「@作者 · 条数 · 本周更新」; the tonal pill adds the pack (添加 → 已添加). Reply templates have no pill: they open the detail sheet. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <View
        android:id="@+id/community_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/community_item_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_community_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorPrimary"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/community_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/community_item_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- Reply templates only: their prompt has no entry count, so the description says what they are. -->
            <TextView
                android:id="@+id/community_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/community_item_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="?attr/colorPrimary"
            android:textFontWeight="600"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
