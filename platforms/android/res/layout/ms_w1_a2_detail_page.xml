<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页骨架（DetailPage）：滚动区里先是 64dp 高的大标题行（28sp，右侧可放页面自己的操作按钮），再是放各组设置的内容列；顶栏叠在最上面，返回按钮一直可见，滚过 28dp 后顶栏铺上页面底色、22sp 的栏标题淡入、大标题淡出。id 是固定的，滚动位置靠它在重建和进程恢复后还原。文案（返回按钮的读屏说明、标题）由 DetailPage 在代码里设置。 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ms_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ms_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ms_detail_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="56dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/ms_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp" />

                <LinearLayout
                    android:id="@+id/ms_detail_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ms_detail_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/ms_detail_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/ms_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ms_w1_a2_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/ms_detail_bar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="64dp"
            android:layout_marginEnd="16dp"
            android:alpha="0"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />
    </FrameLayout>
</FrameLayout>
