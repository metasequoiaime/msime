<?xml version="1.0" encoding="utf-8"?>
<!-- 统计 tab：大标题和选项菜单，分段 概览 / 习惯 / 按键 / 成就，下面是当前分段的卡片（由 StatisticsFragment 在 statistics_content 里搭），最后是「统计只保存在本机」页脚。 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/statistics_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:paddingBottom="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:paddingStart="8dp"
                android:paddingTop="22dp"
                android:paddingBottom="14dp"
                android:text="@string/tab_statistics"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statistics_menu"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:contentDescription="统计选项"
                app:icon="@drawable/ic_statistics_menu"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <app.msime.android.home.SegmentedControl
            android:id="@+id/statistics_sections"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <TextView
            android:id="@+id/statistics_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/statistics_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/statistics_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="统计只保存在本机，不包含输入内容"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
