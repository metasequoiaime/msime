<?xml version="1.0" encoding="utf-8"?>
<!-- The design's Android onboarding: a 4dp progress bar instead of a step counter, the page, and a bar with a text button on the left (跳过, then 上一步) and the filled step action on the right. -->
<!-- fitsSystemWindows 会用系统栏内边距覆盖同一个 view 上的 padding，原来左右 24dp 因此变成 0；系统栏内边距放在外层，24dp 的页边距放在内层。 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="30dp">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/onboarding_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="4"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="?attr/colorPrimaryContainer"
        app:trackCornerRadius="2dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="4dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/onboarding_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/onboarding_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <!-- Two ids, one place: step 0 shows onboarding_skip and every later step shows onboarding_previous, so either button keeps the id tests and older callers know it by. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_skip"
            style="@style/Widget.MSIME.OnboardingText"
            android:text="@string/onboarding_skip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_previous"
            style="@style/Widget.MSIME.OnboardingText"
            android:text="@string/onboarding_previous"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The last step's way out without signing in, paired with 登录 on the trailing edge as in the design's Android footer. The style's negative start margin is for the leading edge, so it is reset here. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_later"
            style="@style/Widget.MSIME.OnboardingText"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"
            android:text="@string/onboarding_later"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textSize="14sp"
            app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
