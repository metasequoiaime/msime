<?xml version="1.0" encoding="utf-8"?>
<!-- 一类社区作品的完整列表（CommunityFragment），从皮肤、词库、表达、AI 润色与回复几个功能页的「浏览更多…」压进来：左上角返回和这一类的大标题、胶囊搜索框、皮肤的分类筛选条，然后是列表。皮肤排成两列预览卡，词库、短语包和回复模板是一张分组卡片里的行（见 CommunityAdapter）。列表左右各缩进 10dp，每张卡片四周 6dp 的外边距让卡片外缘落在 16dp 的页边距上，两列之间留 12dp。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 和详情页（ms_w1_a2_detail_page）一样的 64dp 标题行：40dp 返回按钮，标题从 56dp 处开始。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/ms_large_title_padding_horizontal">

        <ImageButton
            android:id="@+id/community_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ms_w1_a2_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/community_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/community_search_field"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_large_title_padding_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/ms_large_title_padding_horizontal"
        app:boxBackgroundColor="?attr/colorSurfaceContainer"
        app:boxCornerRadiusBottomEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusTopStart="28dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/community_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 皮肤的分类筛选条：「全部」和八个分类，一行横向滚动。词库和短语没有分类，切过去时隐藏。 -->
    <HorizontalScrollView
        android:id="@+id/community_categories_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ms_large_title_padding_horizontal"
        android:paddingEnd="@dimen/ms_large_title_padding_horizontal"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/community_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- 首屏读取、切换分类和搜索时的转圈，画在下面那行提示文字上方；读完或失败时隐藏。 -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/community_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="32dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/community_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/ms_large_title_padding_horizontal"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/community_retry"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ms_large_title_padding_horizontal"
        android:layout_marginTop="12dp"
        android:text="重试"
        android:visibility="gone"
        app:cornerRadius="20dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/community_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="120dp" />
</LinearLayout>
