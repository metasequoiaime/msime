<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏光晕：设计的 radial-gradient(accent@0.34 → transparent 65%)，颜色取本季的 ?attr/msSplashGlow。CSS 的 circle 渐变量到最远角（边长的 √2/2），65% 停在边长约 46% 处，就是下面的半径。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="46%"
        android:startColor="?attr/msSplashGlow"
        android:endColor="@android:color/transparent" />
</shape>
