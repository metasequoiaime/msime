<?xml version="1.0" encoding="utf-8"?>
<!-- Material Symbols「close」（Apache 2.0），反馈页移除已选的截图。默认着次要文字色，使用处可以另行着色。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="?attr/colorOnSurfaceVariant">
    <!-- Material Symbols 的 viewBox 是 0 -960 960 960，平移回画布内。 -->
    <group android:translateY="960">
        <path
            android:fillColor="@android:color/white"
            android:pathData="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
    </group>
</vector>
