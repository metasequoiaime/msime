    <item>
        <shape android:shape="oval">
            <solid android:color="?android:attr/colorBackground" />
        </shape>
    </item>
    <item android:drawable="@drawable/splash_mark" android:gravity="center" android:width="28dp" android:height="28dp" />
</layer-list>
