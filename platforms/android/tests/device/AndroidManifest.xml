                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name="app.msime.android.test.BatchEditorActivity" android:exported="true" />
        <!-- 系统文档选择器可见的合成目录；产品必须通过选择器取得跨 UID 授权。 -->
        <provider android:name="app.msime.android.test.DiagnosticDocumentsProvider"
            android:authorities="app.msime.android.test.diagnostic-documents" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <!-- 合成服务只发回调，不录音；专用模拟器测试结束后恢复系统的默认识别服务。 -->
        <service android:name="app.msime.android.test.LegacySyntheticSpeechService" android:enabled="false" android:exported="true" android:permission="android.permission.RECORD_AUDIO">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <service android:name="app.msime.android.test.SyntheticSpeechService" android:enabled="false" android:exported="true" android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <activity android:name="app.msime.android.test.QuoteEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- 明暗验收保留合成编辑器的焦点和输入连接，只让输入法收到系统配置变化。 -->
