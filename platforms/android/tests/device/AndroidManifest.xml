        <provider android:name="app.msime.android.test.EditorProbeProvider" android:authorities="app.msime.android.test.editor-probe" android:exported="true" />
        <activity android:name="app.msime.android.test.EnglishCorrectionEditorActivity" android:exported="true" android:windowSoftInputMode="adjustResize" />
