<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:versionCode="1" android:versionName="0.1.0-dev">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 用户打开拍照识字时才通过独立设置页申请，不要求设备具备相机。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 关于页「检查更新」下载安装包后交给系统安装器。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 自动更新下载好安装包后发一条通知，点了交给系统安装器；开关默认关闭，打开时才请求这项权限。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自动更新的每日任务在重启后保留（JobInfo.setPersisted）。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 按需资源包（日文词典、语言词库、离线释义、本地语音运行库）在用户点下载后由前台服务下载，带进度通知；按流量计费的网络先确认大小，所以要读网络状态。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <!-- 系统语音识别：SpeechRecognizer 绑定的是 RecognitionService。Android 11 起包可见性收紧，只声明 RECOGNIZE_SPEECH 时，识别服务和识别界面不在同一个包的设备上会被判为没有识别服务。https 的 VIEW 查询给拍照识字设置的「下载地址」用：不声明时 queryIntentActivities 在 Android 11 起总是返回空，会把装了浏览器的设备也判为无法打开。 -->
    <queries><intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent><intent><action android:name="android.speech.RecognitionService" /></intent><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent><intent><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="https" /></intent></queries>
    <!-- 明文 http 只给 AI 辅助的本机、局域网接口用，原因和边界见 res/xml/network_security_config.xml。 -->
    <!-- application 上显式关掉预测式返回：targetSdk 36 起不写就默认打开，而 :ime 进程里的输入法服务靠 KEYCODE_BACK 收起面板。 -->
    <application android:theme="@style/Theme.MSIME" android:label="@string/app_name" android:icon="@drawable/app_icon_classic" android:allowBackup="false" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config" android:enableOnBackInvokedCallback="false">
        <!-- 返回手势走 OnBackPressedDispatcher 的预测式返回，只在宿主的 HomeActivity 上打开，覆盖 application 上的关闭。adjustResize 写明而不留给系统猜：「对话」tab 的输入栏和各页的搜索框都按键盘的 inset 让位，平移窗口会把它们顶出屏幕；不带 stateVisible，键盘只在「试用键盘」切到对话 tab 时由页面自己弹出。 -->
        <activity android:name="app.msime.android.home.HomeActivity" android:exported="true" android:enableOnBackInvokedCallback="true" android:windowSoftInputMode="adjustResize">
        </activity>
        <activity android:name="app.msime.android.home.OnboardingActivity" android:exported="false" />
        <activity android:name="app.msime.android.home.KeyboardTryoutActivity" android:exported="false" android:windowSoftInputMode="adjustResize|stateVisible" />
        <!-- Apple 网页登录的回调：浏览器授权后跳回 `${applicationId}://auth/apple`。它不显示界面，只接受本应用刚发起、尚未完成、未过期的那次登录。 -->
        <activity android:name="app.msime.android.home.AuthRedirectActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="auth" android:path="/apple" />
            </intent-filter>
        </activity>
        <!-- 图标只切换别名，真实宿主始终启用；禁用真实 Activity 会让系统稍后把经别名打开的页面也关闭。 -->
        <activity-alias android:name=".MainActivityClassic" android:targetActivity="app.msime.android.home.HomeActivity" android:icon="@drawable/app_icon_classic" android:enabled="true" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityForest" android:targetActivity="app.msime.android.home.HomeActivity" android:icon="@drawable/app_icon_forest" android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivitySky" android:targetActivity="app.msime.android.home.HomeActivity" android:icon="@drawable/app_icon_sky" android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityDusk" android:targetActivity="app.msime.android.home.HomeActivity" android:icon="@drawable/app_icon_dusk" android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias android:name=".MainActivityVermilion" android:targetActivity="app.msime.android.home.HomeActivity" android:icon="@drawable/app_icon_vermilion" android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity android:name="app.msime.android.OcrCaptureActivity" android:process=":ime" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|keyboard|keyboardHidden|navigation" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name="app.msime.android.OcrSetupActivity" android:exported="false" android:label="拍照识字设置" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name="app.msime.android.VoiceRecognitionActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <activity android:name="app.msime.android.ClipboardAuthenticationActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <activity android:name="app.msime.android.WorldClockCityActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" android:windowSoftInputMode="adjustResize" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity android:name="app.msime.android.OfflineVoiceRecognitionActivity" android:label="水杉离线语音输入" android:exported="true" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 自动更新：每天一次检查、下载并核对更新，只在用户打开「自动更新」后排程。 -->
        <service android:name="app.msime.android.home.UpdateJobService" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 按需资源包下载：只由用户操作启动，跑在主进程（不设 android:process），:ime 进程从不安装资源包。 -->
        <service android:name="app.msime.android.ResourcePackService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name="app.msime.android.MSIMEInputService" android:process=":ime" android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <provider
            android:name="app.msime.android.AccountSessionProvider"
            android:authorities="${applicationId}.account-session"
            android:exported="false" />
        <provider
            android:name="app.msime.android.MlKitImeInitProvider"
            android:authorities="${applicationId}.mlkit-ime-init"
            android:exported="false"
            android:process=":ime" />
        <!-- ML Kit 手写经 Google datatransport 把 FIREBASE_ML_SDK 诊断事件（带持久的 ml_sdk_instance_id、机型、系统指纹、语言、时区等）存进应用数据库，再排一个 JobScheduler 任务上传到 firebaselogging.googleapis.com（2026-10-25 真机抓包确认）。删掉后端发现服务，datatransport 找不到 cct 后端就不存事件、不排任务；再删掉上传任务和闹钟入口，旧版本存下的事件也没有上传途径。识别和模型下载不经过这条路径。 -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />
        <!-- 把缓存里的诊断包、更新安装包、导出文件、键盘发送的剪贴板图片副本和表情包贴纸以 content:// 交给别的应用，可分享的目录见 res/xml/msime_file_paths.xml。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/msime_file_paths" />
        </provider>
    </application>
</manifest>
