# 插件解析器的共享 fixture 要逐字节保留（CRLF、BOM、行尾空格和非法字节都是用例的一部分），不做换行转换，也不做空白检查。
crates/client-services/tests/fixtures/plugin-packs/** -text -whitespace

# 决策笔记的归档封印对原始字节做 SHA-256，格式门禁又要求 Status 行逐字匹配；行尾跨平台必须是
# LF，否则 Windows 的 autocrlf 检出成 CRLF 后，归档必然失败、封印哈希因机器而异。
.agents/notes/** text eol=lf

# 拆字表由 scripts/build_chaizi_table.py 生成、按 split_once('\t') 解析，Windows 的 autocrlf 检出成 CRLF 后行尾的 \r 会进最后一个字段，--check 也会逐字节失败。
crates/engine/src/local/chaizi*.tsv text eol=lf

# 这些生成结果按字节校验；Windows 检出也保留生成器写入的 LF。
crates/engine/src/local/symbol_groups.tsv text eol=lf
crates/engine/src/local/symbol_candidates.tsv text eol=lf
plugins/phrase_table/latex-symbols/symbols.tsv text eol=lf
docs/plugin-architecture.html text eol=lf
packages/ui/src/voice/voice-language-catalog.json text eol=lf
packages/ui/src/settings/voice-hold-key-catalog.ts text eol=lf
shared/voice/VoiceLanguageCatalog.h text eol=lf
shared/voice/VoiceHoldKeyCatalog.h text eol=lf
platforms/android/java/app/msime/android/voice/VoiceLanguageCatalog.java text eol=lf
platforms/ios/App/Services/VoiceLanguageCatalog.swift text eol=lf

# Unicode 许可证按锁文件校验原始字节，跨平台检出必须保持 LF。
resources/licenses/Unicode-License-V3.txt text eol=lf

# OpenCC 许可证与固定源码输入逐字节核对，Windows 检出也保持 LF。
resources/licenses/OpenCC-Apache-2.0.txt text eol=lf

# Android OCR 模块的三份许可证与 resources/ocr-models-android.lock.json 固定的上游字节逐字节核对，Windows 检出也保持 LF。
resources/licenses/onnxruntime-MIT.txt text eol=lf
resources/licenses/onnxruntime-ThirdPartyNotices.txt text eol=lf
resources/licenses/PaddleOCR-Apache-2.0.txt text eol=lf

# GitHub 语言统计默认归入 Rust，主要语言仅按扩展名覆盖。
* linguist-language=Rust
*.cpp linguist-language=C++
*.h linguist-language=C++
*.hpp linguist-language=C++
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.ets linguist-language=TypeScript
*.java linguist-language=Java
*.swift linguist-language=Swift
*.mm linguist-language=Objective-C++
