+use super::*;
+use crate::lattice::decode::DigitLatticeEdge;
+
+/// 按数字位置保留全部完整音节，不经过按频度截断的切分路径。
+fn syllable_edges<'a>(table: &'a SpellingTable, digits: &str) -> Vec<Vec<(usize, &'a str)>> {
+    (0..digits.len())
+        .map(|start| {
+            let mut edges = Vec::new();
+            for end in start + 1..=digits.len().min(start + table.longest_code) {
+                if let Some(pieces) = table.by_code.get(&digits[start..end]) {
+                    edges.extend(
+                        pieces.iter().filter_map(|(piece, complete)| {
+                            complete.then_some((end, piece.as_str()))
+                        }),
+                    );
+                }
+            }
+            edges
+        })
+        .collect()
+}
+
+/// 单字精确查询、两音节精确与长词前缀查询共同构造数字词边；没有完整音节路径时沿用旧查询。
+pub(super) fn build_edges(
+    dictionary: &mut QuanpinDictionary,
+    table: &SpellingTable,
+    digits: &str,
+) -> Option<Vec<DigitLatticeEdge>> {
+    let syllables = syllable_edges(table, digits);
+    let mut reaches_end = vec![false; digits.len() + 1];
+    reaches_end[digits.len()] = true;
+    for start in (0..digits.len()).rev() {
+        reaches_end[start] = syllables[start].iter().any(|&(end, _)| reaches_end[end]);
+    }
+    if !reaches_end[0] {
+        return None;
+    }
+    let mut reachable = vec![false; digits.len() + 1];
+    reachable[0] = true;
+    let mut edges = Vec::new();
+    let mut seen = HashSet::new();
+    for start in 0..digits.len() {
+        if !reachable[start] {
+            continue;
+        }
+        for &(end, first) in &syllables[start] {
+            if !reaches_end[end] {
+                continue;
+            }
+            reachable[end] = true;
+            for row in dictionary.query_lattice_span_rows(&[first.to_owned()], 32) {
+                let identity = (start, end, row.key.clone(), row.value.clone());
+                if seen.insert(identity) {
+                    edges.push(DigitLatticeEdge {
+                        start,
+                        end,
+                        word: row.value,
+                        key: row.key,
+                        weight: row.weight,
+                        syllables: 1,
+                    });
+                }
+            }
+            if end == digits.len() {
+                continue;
+            }
+            for &(second_end, second) in &syllables[end] {
+                if !reaches_end[second_end] {
+                    continue;
+                }
+                let prefix = [first.to_owned(), second.to_owned()];
+                for row in dictionary.query_lattice_prefix_rows(&prefix) {
+                    let count = reading_syllable_count(&row.key);
+                    if count > 7 {
+                        continue;
+                    }
+                    let word_end = start + row.key.bytes().filter(u8::is_ascii_lowercase).count();
+                    let Some(code) = digits.get(start..word_end) else {
+                        continue;
+                    };
+                    if !reaches_end[word_end] || table.grid.encode(&row.key) != code {
+                        continue;
+                    }
+                    let identity = (start, word_end, row.key.clone(), row.value.clone());
+                    if seen.insert(identity) {
+                        edges.push(DigitLatticeEdge {
+                            start,
+                            end: word_end,
+                            word: row.value.clone(),
+                            key: row.key.clone(),
+                            weight: row.weight,
+                            syllables: count,
+                        });
+                    }
+                }
+            }
+        }
+    }
+    Some(edges)
+}
