+            dictionaries: directory.path().into(),
+        };
+        let mut dictionary = QuanpinDictionary::new(&paths);
+        let table = KeyGrid::NineKey.spelling_table();
+        let before = build_edges(&mut dictionary, table, "9426626").unwrap();
+        assert!(before
+            .iter()
+            .any(|edge| edge.start == 0 && edge.end == 7 && edge.word == "甲乙丙"));
+        assert!(!before.iter().any(|edge| edge.word == "甲乙丁"));
+        let other = PinyinDatabase::open(&database);
+        other.insert_word("xi'an'nan", "合成词").unwrap();
+        let after = build_edges(&mut dictionary, table, "9426626").unwrap();
+        assert!(after.iter().any(|edge| edge.word == "合成词"));
+    }
+
+    #[test]
+    fn every_complete_reading_remains_available_without_a_path_limit() {
+        let table = KeyGrid::NineKey.spelling_table();
+        let graph = syllable_edges(table, "9426626");
+        assert!(graph[0]
+            .iter()
+            .any(|&(end, syllable)| end == 2 && syllable == "xi"));
+        assert!(graph[0]
+            .iter()
+            .any(|&(end, syllable)| end == 2 && syllable == "yi"));
+        assert!(graph[0]
+            .iter()
+            .any(|&(end, syllable)| end == 4 && syllable == "xian"));
+        assert!(graph[2]
+            .iter()
+            .any(|&(end, syllable)| end == 4 && syllable == "an"));
+        assert!(graph[4]
+            .iter()
+            .any(|&(end, syllable)| end == 7 && syllable == "nan"));
+    }
+}
