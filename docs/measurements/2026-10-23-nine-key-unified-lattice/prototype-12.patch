+    pub fn query_lattice_prefix(
+        &self,
+        prefix: &[String],
+        max_extra_syllables: usize,
+        limit: usize,
+    ) -> Vec<DictRow> {
+        if self.connection.is_none()
+            || prefix.len() < 2
+            || max_extra_syllables == 0
+            || limit == 0
+            || !has_only_complete_pinyin_segments(prefix)
+        {
+            return Vec::new();
+        }
+        let pages = max_extra_syllables.min(
+            MAXIMUM_NUMBERED_SYLLABLES
+                .saturating_sub(prefix.len())
+                .saturating_add(1),
+        );
+        let prefix_key = longer_phrase_prefix(prefix);
+        let upper_bound = key_prefix_upper_bound(&prefix_key);
+        let Some(initial) = prefix[0].as_bytes().first().copied() else {
+            return Vec::new();
+        };
+        let mut rows = Vec::new();
+        for extra in 1..=pages {
+            let Some(table) = quanpin_table(prefix.len() + extra, initial) else {
+                continue;
+            };
+            let remaining = limit.saturating_sub(rows.len());
+            if remaining == 0 {
+                break;
+            }
+            rows.extend(self.rows(
+                &range_sql(&table, sql_limit(remaining)),
+                [prefix_key.as_str(), upper_bound.as_str()],
+                query_capacity(remaining),
+            ));
+        }
+        rows.sort_by_key(|row| std::cmp::Reverse(row.weight));
+        rows.truncate(limit);
+        rows
+    }
