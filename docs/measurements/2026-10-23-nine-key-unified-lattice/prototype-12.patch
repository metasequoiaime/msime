+/// 数字层词网格的一条边。列是数字位置而不是固定音节位置，`key` 仍保留这条词边的全拼读法。
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DigitLatticeEdge {
+    pub start: usize,
+    pub end: usize,
+    pub word: String,
+    pub key: String,
+    pub weight: i64,
+    pub syllables: usize,
+}
+
 /// Edges by start column.
 pub(super) type Graph = Vec<Vec<Edge>>;

+/// 在数字位置组成的共享词网格上解码整句。
+pub fn decode_digit_lattice(
+    digit_count: usize,
+    edges: &[DigitLatticeEdge],
+    options: &LatticeOptions<'_>,
+) -> Vec<SentencePath> {
+    if digit_count == 0 {
+        return Vec::new();
+    }
+    let mut graph: Graph = (0..digit_count).map(|_| Vec::new()).collect();
+    for edge in edges {
+        if edge.start >= edge.end
+            || edge.end > digit_count
+            || edge.word.is_empty()
+            || edge.key.is_empty()
+            || edge.syllables == 0
+        {
+            continue;
+        }
+        graph[edge.start].push(Edge {
+            end: edge.end,
+            word: edge.word.clone(),
+            key: edge.key.clone(),
+            log_prob: edge_log_prob(edge.weight, edge.syllables, options)
+                - PHRASE_LENGTH_BONUS * edge.syllables as f64,
+            typo: false,
+        });
+    }
+    decode_graph(&graph, options, None)
+}
