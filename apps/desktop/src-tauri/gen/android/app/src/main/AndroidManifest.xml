<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries><intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent></queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.msime_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name="app.msime.android.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="app.msime.android.MainActivityForest"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest"
            android:label="@string/app_name"
            android:targetActivity="app.msime.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="app.msime.android.MainActivitySky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sky"
            android:label="@string/app_name"
            android:targetActivity="app.msime.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="app.msime.android.MainActivityDusk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dusk"
            android:label="@string/app_name"
            android:targetActivity="app.msime.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="app.msime.android.MainActivityVermilion"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vermilion"
            android:label="@string/app_name"
            android:targetActivity="app.msime.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name="app.msime.android.VoiceRecognitionActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <service android:name="app.msime.android.MSIMEInputService" android:process=":ime" android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/tauri_method" />
        </service>
        <provider
            android:name="app.msime.android.MlKitImeInitProvider"
            android:authorities="${applicationId}.mlkit-ime-init"
            android:exported="false"
            android:process=":ime" />

    </application>
</manifest>
